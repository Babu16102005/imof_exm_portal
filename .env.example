VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_MOCK_MODE=true
# Mock-mode admin login (VITE_MOCK_MODE=true or Supabase not configured):
# AuthContext compares the login form against VITE_ADMIN_ID / VITE_ADMIN_PASSWORD locally.
VITE_ADMIN_ID=admin
VITE_ADMIN_PASSWORD=imof2026
# Live admin login (VITE_MOCK_MODE=false):
# Admin login is via the admins table + verify_admin_login RPC
# (the client never holds admin credentials; the server issues a session
# token that is sent back as the x-admin-token header).
